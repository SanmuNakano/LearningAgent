{
  "name": "openclaw-plugin-qq-study-router",
  "version": "0.4.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm test",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run check",
    "plugin:validate:tool": "npm run build && openclaw plugins validate --entry ./dist/index.js",
    "test": "vitest run",
    "supervisor:serve": "npm run build && node ./dist/supervisor.js --serve --project D:\\learn\\openclaw-plugins"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "openclaw": "latest",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
